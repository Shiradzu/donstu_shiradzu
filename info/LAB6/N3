arr = [4, -2, 7, -8, 5, -1, 3]

total_count = 0
neg_count = 0

for item in arr:
    total_count += 1
    if item < 0:
        neg_count += 1

print("Количество отрицательных элементов:", neg_count)
print("Всего элементов:", total_count)

if neg_count < total_count / 2:
    last_index = total_count - 1
    arr[last_index] = -arr[last_index]
    print("Условие выполнено: знак последнего элемента изменен.")
else:
    print("Условие не выполнено: массив оставлен без изменений.")

print("Итоговый массив:", arr)
