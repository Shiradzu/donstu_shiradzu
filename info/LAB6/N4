n = int(input("Введите количество элементов N (N > 1): "))
a = float(input("Введите первый член прогрессии A: "))
d = float(input("Введите знаменатель D: "))

progression = []
current_term = a

for i in range(n):
    progression.append(current_term)
    current_term *= d

print("Сформированный массив геометрической прогрессии:")
print(progression)
