import math

x = float(input("Введите x: "))
lam = float(input("Введите λ (lambda): "))
R = float(input("Введите R: "))

numerator1 = 2
denominator1 = math.sqrt(x)

numerator2 = x - lam / R
denominator2 = ((x - lam / 2) ** 2 + lam ** 2) ** (1 / 3)

result = (numerator1 / denominator1) * (numerator2 / denominator2)

print("Результат:", result)
